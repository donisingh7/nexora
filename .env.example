# Local development values only. Replace the database password before exposing any service.
POSTGRES_USER=nexora_dev
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=nexora
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexora_dev:replace-this-local-password@localhost:5432/nexora

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/objects
# Optional S3 configuration (credentials may also use the AWS default credential chain -
# e.g. a Lambda execution role in production; never commit real keys here):
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional generation provider:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Optional SQS queue for a push-based (Lambda) ingestion worker. Unset = local polling
# worker (app.workers.run_ingestion) only, which always works regardless of this value.
# INGESTION_QUEUE_URL=

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Gemini embeddings (EMBEDDING_PROVIDER=gemini) - lighter weight than bundling
# sentence-transformers/torch into a Lambda package. Not exercised against a live API
# in this repository; see DECISIONS.md.
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MAX_UPLOAD_SIZE_BYTES=25000000
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/markdown","text/x-markdown"]
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
DENSE_CANDIDATE_COUNT=30
LEXICAL_CANDIDATE_COUNT=30
DEFAULT_RETRIEVAL_TOP_K=8
RRF_CONSTANT=60
RERANKER_ENABLED=false
MAX_INGESTION_ATTEMPTS=3
INGESTION_STALE_AFTER_SECONDS=600
